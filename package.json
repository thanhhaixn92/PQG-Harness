{
  "name": "deepseek-harness",
  "version": "0.1.0",
  "private": true,
  "description": "Official DeepSeek Harness Web UI on EdgeOne Makers. Models go through the Makers AI Gateway; the workspace is the current session sandbox.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TencentEdgeOne/deepseek-harness.git"
  },
  "engines": {
    "node": "^22.19 || >=24"
  },
  "type": "module",
  "scripts": {
    "prepare:makers-runtime": "npm ci --ignore-scripts --os=linux --cpu=x64 --include=optional && node scripts/restore-host-frontend-natives.mjs",
    "prepare:dsh-web": "node scripts/prepare-dsh-web.mjs && node scripts/apply-product-layer.mjs && node scripts/generate-dsh-api-routes.mjs",
    "dev": "vite",
    "build": "npm run prepare:dsh-web && npm run build:prepared",
    "build:prepared": "vite build && node scripts/write-build-meta.mjs",
    "build:makers": "npm run build && npm run prepare:makers-runtime && node scripts/prune-agent-dependencies.mjs && node scripts/clean-agent-node.mjs",
    "test": "npm run prepare:dsh-web && node --experimental-strip-types --test tests/*.test.ts",
    "test:prepared": "node --experimental-strip-types --test tests/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@deepseek-ai/cordis-plugin-group": "^1.0.1",
    "@deepseek-ai/cordis-plugin-timer": "1.1.3",
    "@deepseek-ai/dsh": "0.1.0-rc.6",
    "@deepseek-ai/dsh-agent": "0.1.0-rc.6",
    "@deepseek-ai/dsh-agent-loop": "0.1.0-rc.6",
    "@deepseek-ai/dsh-anonymous-user-id": "0.1.0-rc.6",
    "@deepseek-ai/dsh-atomic-write": "0.1.0-rc.6",
    "@deepseek-ai/dsh-bash-local": "0.1.0-rc.6",
    "@deepseek-ai/dsh-client-web": "0.1.0-rc.6",
    "@deepseek-ai/dsh-code-runtime": "0.1.0-rc.6",
    "@deepseek-ai/dsh-compaction": "0.1.0-rc.6",
    "@deepseek-ai/dsh-fs": "0.1.0-rc.6",
    "@deepseek-ai/dsh-invariants": "0.1.0-rc.6",
    "@deepseek-ai/dsh-llm": "0.1.0-rc.6",
    "@deepseek-ai/dsh-llm-pi-ai": "0.1.0-rc.6",
    "@deepseek-ai/dsh-output-retention": "0.1.0-rc.6",
    "@deepseek-ai/dsh-sandbox": "0.1.0-rc.6",
    "@deepseek-ai/dsh-scope": "0.1.0-rc.6",
    "@deepseek-ai/dsh-sdk-client": "0.1.0-rc.6",
    "@deepseek-ai/dsh-sdk-jsonrpc-demo": "0.1.0-rc.6",
    "@deepseek-ai/dsh-sdk-jsonrpc-server": "0.1.0-rc.6",
    "@deepseek-ai/dsh-sdk-protocol": "0.1.0-rc.6",
    "@deepseek-ai/dsh-session": "0.1.0-rc.6",
    "@deepseek-ai/dsh-session-telemetry": "0.1.0-rc.6",
    "@deepseek-ai/dsh-session-title-llm": "0.1.0-rc.6",
    "@deepseek-ai/dsh-shell": "0.1.0-rc.6",
    "@deepseek-ai/dsh-spill": "0.1.0-rc.6",
    "@deepseek-ai/dsh-subagent-in-process-driver": "0.1.0-rc.6",
    "@deepseek-ai/dsh-subprocess": "0.1.0-rc.6",
    "@deepseek-ai/dsh-system-prompt": "0.1.0-rc.6",
    "@deepseek-ai/dsh-timeout": "0.1.0-rc.6",
    "@deepseek-ai/dsh-tools": "0.1.0-rc.6",
    "@deepseek-ai/dsh-web-frontend": "0.1.0-rc.6",
    "@deepseek-ai/dsh-workflow": "0.1.0-rc.6",
    "@modelcontextprotocol/sdk": "1.29.0",
    "ws": "8.21.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/ws": "^8.18.1",
    "typescript": "^6.0.0",
    "vite": "^7.0.0"
  },
  "optionalDependencies": {
    "@img/sharp-libvips-linux-x64": "^1.3.2",
    "@img/sharp-linux-x64": "^0.35.3",
    "@koromix/koffi-linux-x64": "^3.1.5"
  }
}
